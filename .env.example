# Used by the Express API. Add real values only in your local .env and Render.
MONGODB_URI=mongodb+srv://DATABASE_USER:DATABASE_PASSWORD@cluster0.example.mongodb.net/product-gallery?retryWrites=true&w=majority
CLIENT_ORIGIN=http://localhost:5173
PORT=5000
NODE_ENV=development

# Optional: only use this if your local DNS resolver blocks Atlas SRV lookups.
# MONGODB_DNS_SERVERS=8.8.8.8,8.8.4.4

# Used by Vite in the browser. Use your Render API URL after deployment.
VITE_API_URL=http://localhost:5000/api
